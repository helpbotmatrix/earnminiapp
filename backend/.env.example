# ══════════════════════════════════════════════════════════════════════
# EARN MINI APP BACKEND ENVIRONMENT CONFIGURATION
# ══════════════════════════════════════════════════════════════════════

# Server Port & Mode
PORT=3000
APP_ENV=production

# PostgreSQL Connection (Tuned for 2 vCPU / 4GB RAM VPS)
DATABASE_URL=postgres://postgres:your_password@localhost:5432/earnminiapp?sslmode=disable
DB_MAX_CONNS=30
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME_MINS=30
DB_MAX_CONN_IDLE_MINS=5

# Redis Cache & Leaderboard URL
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=super-secret-telegram-earn-mini-app-jwt-key-2026
JWT_EXPIRATION_HOURS=72

# Telegram Bot Credentials & Webhook URL
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHANNEL_ID=@SpinCraftCommunity

# Your HTTPS Server Domain (Server automatically registers webhook with Telegram on boot!)
SERVER_BASE_URL=https://api.yourdomain.com

# Direct Mini App WebApp Link
MINI_APP_URL=https://t.me/SpinCraft_bot/earnnow

# Admin Identification (Comma-separated Telegram User IDs who can access in-app Admin Panel)
ADMIN_TELEGRAM_IDS=123456789,987654321

# Rate Limiting (DDoS & Spam Protection)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECS=60

# ══════════════════════════════════════════════════════════════════════
# BSC (BEP-20) CRYPTO ENGINE & ALCHEMY INTEGRATION
# ══════════════════════════════════════════════════════════════════════
# Primary Alchemy BSC RPC & Webhooks (Recommended for high throughput & zero rate-limits)
ALCHEMY_API_KEY=your-alchemy-api-key
ALCHEMY_NOTIFY_TOKEN=your-alchemy-notify-token
ALCHEMY_WEBHOOK_ID=your-alchemy-webhook-id
ALCHEMY_SIGNING_KEY=your_alchemy_webhook_signing_key

# Optional: Custom BSC RPC (Defaults to Alchemy if ALCHEMY_API_KEY is set)
BSC_RPC_URL=
BSC_CHAIN_ID=56
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# Master Admin Funding & Payout Wallet (Optional: can be auto-generated in Admin Panel!)
ADMIN_MASTER_PRIVATE_KEY=
ADMIN_MASTER_ADDRESS=

# Admin Panel In-App Authorization Secret Passphrase
ADMIN_SECRET_KEY=super-admin-secret-key-2026
