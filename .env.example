# ═══════════════════════════════════════════════════════════════
# EarnMiniApp — Railway Environment Variables
# Railway Dashboard → Service → Variables এ এগুলো সেট করুন
# ═══════════════════════════════════════════════════════════════

# Auto-set by Railway (কাস্টম লাগবে না)
PORT=8080
APP_ENV=production

# PostgreSQL — Railway Postgres plugin connect করলে DATABASE_URL অটো আসে
DATABASE_URL=postgresql://user:pass@host:5432/earnminiapp?sslmode=require

# Redis — Railway Redis plugin connect করলে REDIS_URL অটো আসে
REDIS_URL=redis://default:pass@host:6379

# JWT (শক্তিশালী র্যান্ডম স্ট্রিং দিন)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_HOURS=72

# Telegram BotFather থেকে
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
SERVER_BASE_URL=https://YOUR-SERVICE.up.railway.app
MINI_APP_URL=https://t.me/YOUR_BOT/YOUR_APP

# Admin
ADMIN_SECRET_KEY=change-me-admin-passphrase
ADMIN_TELEGRAM_IDS=

# Optional BSC / Alchemy
ALCHEMY_API_KEY=
BSC_RPC_URL=
BSC_CHAIN_ID=56
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955
ADMIN_MASTER_PRIVATE_KEY=
ADMIN_MASTER_ADDRESS=

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECS=60
# Comma-separated browser origins (optional). Example: https://your-app.up.railway.app
ALLOWED_ORIGINS=
# JWT lifetime hours (shorter = safer)
JWT_EXPIRATION_HOURS=12
